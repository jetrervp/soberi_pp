generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  ADMIN
  USER
}

enum StoreRole {
  OWNER
  MANAGER
}

enum StoreStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  BLOCKED
}

model User {
  id            String        @id @default(uuid())
  email         String        @unique
  password      String
  name          String
  emailVerified Boolean       @default(false) 
  role          PlatformRole  @default(USER)
  isBlocked     Boolean       @default(false)
  createdAt     DateTime      @default(now())
  memberships   StoreMember[]
}

model Store {
  id          String        @id @default(uuid()) 
  name        String
  slug        String        @unique
  description String?
  phone       String?
  address     String?
  logoUrl     String?
  bannerUrl   String?
  status      StoreStatus   @default(DRAFT)
  createdAt   DateTime      @default(now())
  members     StoreMember[]
  goods       Good[]
}

model StoreMember {
  userId  String
  storeId String
  role    StoreRole
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  store   Store     @relation(fields: [storeId], references: [id])

  @@id([userId, storeId])
}

model GoodCategory {
  id       String        @id @default(uuid())
  name     String
  parentId String?
  parent   GoodCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children GoodCategory[] @relation("CategoryTree")
  goods    Good[]
}

model Brand {
  id    String @id @default(uuid())
  name  String @unique
  goods Good[]
}

model Size {
  id    String @id @default(uuid())
  name      String     @unique
  goodSizes GoodSize[]
}

model Good {
  id          String       @id @default(uuid())
  storeId     String
  store       Store        @relation(fields: [storeId], references: [id])
  categoryId  String
  category    GoodCategory @relation(fields: [categoryId], references: [id])
  brandId     String?
  brand       Brand?       @relation(fields: [brandId], references: [id])
  name        String
  description String?
  price       Int
  stock       Int          @default(0)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  sizes       GoodSize[]
}

model GoodSize {
  goodId String
  sizeId String
  stock  Int  @default(0)
  good   Good @relation(fields: [goodId], references: [id])
  size   Size @relation(fields: [sizeId], references: [id])

  @@id([goodId, sizeId])
}

model News {
  id        String   @id @default(uuid())
  title     String
  body      String
  createdAt DateTime @default(now())
}
