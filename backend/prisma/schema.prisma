generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  ADMIN
  USER
}

enum StoreRole {
  OWNER
  MANAGER
}

enum StoreStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  BLOCKED
}

model User {
  id            String        @id @default(uuid())
  email         String        @unique
  password      String
  name          String                    // ← добавили имя
  emailVerified Boolean       @default(false)  // ← добавили флаг
  role          PlatformRole  @default(USER)
  isBlocked     Boolean       @default(false)
  createdAt     DateTime      @default(now())
  memberships   StoreMember[]
}


model Store {
  id        Int           @id @default(autoincrement())
  name      String
  slug      String        @unique
  status    StoreStatus   @default(DRAFT)
  createdAt DateTime      @default(now())
  members   StoreMember[]
  goods     Good[]
}

model StoreMember {
  userId  String
  storeId Int
  role    StoreRole
  user    User      @relation(fields: [userId], references: [id])
  store   Store     @relation(fields: [storeId], references: [id])

  @@id([userId, storeId])
}

model GoodCategory {
  id       Int            @id @default(autoincrement())
  name     String
  parentId Int?
  parent   GoodCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children GoodCategory[] @relation("CategoryTree")
  goods    Good[]
}

model Brand {
  id    Int    @id @default(autoincrement())
  name  String @unique
  goods Good[]
}

model Size {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  goodSizes GoodSize[]
}

model Good {
  id          Int          @id @default(autoincrement())
  storeId     Int
  store       Store        @relation(fields: [storeId], references: [id])
  categoryId  Int
  category    GoodCategory @relation(fields: [categoryId], references: [id])
  brandId     Int?
  brand       Brand?       @relation(fields: [brandId], references: [id])
  name        String
  description String?
  price       Int
  stock       Int          @default(0)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  sizes       GoodSize[]
}

model GoodSize {
  goodId Int
  sizeId Int
  stock  Int  @default(0)
  good   Good @relation(fields: [goodId], references: [id])
  size   Size @relation(fields: [sizeId], references: [id])

  @@id([goodId, sizeId])
}

model News {
  id        Int      @id @default(autoincrement())
  title     String
  body      String
  createdAt DateTime @default(now())
}
